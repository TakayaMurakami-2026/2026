    {
      "cell_type": "code",
      "source": [
        "import csv"
      ],
      "metadata": {
        "id": "nMQLXPQC6aTF"
      },
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "code",
      "source": [
        "def load_tsv(filepath):\n",
        "    \"\"\"\n",
        "    SST-2 の TSV を読み込み、sentences と labels のリストを返す。\n",
        "    ヘッダ行: sentence \\t label\n",
        "    \"\"\"\n",
        "    sentences, labels = [], []\n",
        "    with open(filepath, encoding=\"utf-8\") as f:\n",
        "        reader = csv.DictReader(f, delimiter=\"\\t\")\n",
        "        for row in reader:\n",
        "            sentences.append(row[\"sentence\"])\n",
        "            labels.append(int(row[\"label\"]))   # 0=負(negative), 1=正(positive)\n",
        "    return sentences, labels"
      ],
      "metadata": {
        "id": "IiMT4jyV6Xdh"
      },
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "code",
      "source": [
        "train_sentences, train_labels = load_tsv(\"SST-2/train.tsv\")\n",
        "dev_sentences,   dev_labels   = load_tsv(\"SST-2/dev.tsv\")\n",
        "print(f\"訓練セット: {len(train_sentences):,} 件\")\n",
        "print(f\"開発セット: {len(dev_sentences):,} 件\")"
      ],
      "metadata": {
